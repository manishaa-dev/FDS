{"cells":[{"cell_type":"code","source":["\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","\n","from sklearn.model_selection import train_test_split\n","from sklearn.linear_model import LinearRegression\n","from sklearn.metrics import mean_squared_error, r2_score\n","\n","# Step 1: Create sample dataset\n","data = {\n","    'YearsExperience': [\n","        1.1, 1.3, 1.5, 2.0, 2.2, 2.9, 3.0, 3.2, 3.2, 3.7,\n","        3.9, 4.0, 4.0, 4.1, 4.5, 4.9, 5.1, 5.3, 5.9, 6.0,\n","        6.8, 7.1, 7.9, 8.2, 8.7, 9.0, 9.5, 9.6, 10.3, 10.5\n","    ],\n","    'Salary': [\n","        39343, 46205, 37731, 43525, 39891, 56642, 60150, 54445,\n","        64445, 57189, 63218, 55794, 56957, 57081, 61111, 67938,\n","        66029, 83088, 81363, 93940, 91738, 98273, 101302, 113812,\n","        109431, 105582, 116969, 112635, 122391, 121872\n","    ]\n","}\n","\n","df = pd.DataFrame(data)\n","\n","# Save the dataset as a CSV file\n","df.to_csv('Salary_data.csv', index=False)\n","\n","# Step 2: Load the dataset\n","df = pd.read_csv('Salary_data.csv')\n","\n","print(\"First five rows:\")\n","print(df.head())\n","\n","# Step 3: Display dataset information\n","print(\"\\nDataset Information:\")\n","df.info()\n","\n","# Step 4: Remove missing values\n","df.dropna(inplace=True)\n","\n","# Step 5: Display statistical summary\n","print(\"\\nStatistical Summary:\")\n","print(df.describe())\n","\n","# Step 6: Separate features and target\n","features = df[['YearsExperience']].values\n","label = df[['Salary']].values\n","\n","# Step 7: Split the data into training and testing sets\n","x_train, x_test, y_train, y_test = train_test_split(\n","    features, label, test_size=0.2, random_state=42\n",")\n","\n","# Step 8: Create and train the Linear Regression model\n","model = LinearRegression()\n","model.fit(x_train, y_train)\n","\n","print(\"\\nLinear Regression Model:\")\n","print(model)\n","\n","# Step 9: Predict salaries for test data\n","y_pred = model.predict(x_test)\n","\n","# Step 10: Evaluate the model\n","print(\"\\nTraining Score:\", model.score(x_train, y_train))\n","print(\"Testing Score:\", model.score(x_test, y_test))\n","print(\"R2 Score:\", r2_score(y_test, y_pred))\n","print(\"Mean Squared Error:\", mean_squared_error(y_test, y_pred))\n","\n","# Step 11: Display model coefficients\n","print(\"\\nSlope:\", model.coef_[0][0])\n","print(\"Intercept:\", model.intercept_[0])\n","\n","# Step 12: Visualize the regression line\n","plt.figure(figsize=(8, 5))\n","plt.scatter(features, label, color='blue', label='Actual Salary')\n","plt.plot(\n","    features,\n","    model.predict(features),\n","    color='red',\n","    label='Regression Line'\n",")\n","plt.xlabel('Years of Experience')\n","plt.ylabel('Salary')\n","plt.title('Linear Regression: Experience vs Salary')\n","plt.legend()\n","plt.grid(True)\n","plt.show()\n","\n","# Step 13: Predict salary for new experience\n","years = float(input(\"\\nEnter Years of Experience: \"))\n","predicted_salary = model.predict(np.array([[years]]))\n","\n","print(\n","    f\"Estimated Salary for {years} years of experience: \"\n","    f\"{predicted_salary[0][0]:.2f}\"\n",")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"2Yuvn3AG5iek","outputId":"49e4582b-63a6-4ab4-b895-a1b596b6ea1d"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["First five rows:\n","   YearsExperience  Salary\n","0              1.1   39343\n","1              1.3   46205\n","2              1.5   37731\n","3              2.0   43525\n","4              2.2   39891\n","\n","Dataset Information:\n","<class 'pandas.core.frame.DataFrame'>\n","RangeIndex: 30 entries, 0 to 29\n","Data columns (total 2 columns):\n"," #   Column           Non-Null Count  Dtype  \n","---  ------           --------------  -----  \n"," 0   YearsExperience  30 non-null     float64\n"," 1   Salary           30 non-null     int64  \n","dtypes: float64(1), int64(1)\n","memory 